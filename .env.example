# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL_FAST=gemini-4-hydrogen
GEMINI_MODEL_DEEP=gemini-4-argon
PDF_INGEST_HOURLY_LIMIT=10
PDF_INGEST_DAILY_LIMIT=30

# MongoDB (sync & marketplace)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DB=KnowledgeEngineDB
